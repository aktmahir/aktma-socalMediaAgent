# Copy this file to .env and fill in your own values.
AI_PROVIDER=openai
HUGGINGFACE_MODEL=gpt2
COHERE_MODEL=command-a-03-2025
# Docker Compose reads provider keys from git-ignored secrets files under ./secrets/.
# For standalone deployments, set *_FILE or direct API key environment variables.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
# HUGGINGFACE_API_KEY_FILE=/run/secrets/huggingface_api_key
# COHERE_API_KEY_FILE=/run/secrets/cohere_api_key
# Optional stable Flask session/CSRF signing key; generate with secrets.token_hex(32).
# FLASK_SECRET_KEY=
# Docker Compose reads secrets from git-ignored files under ./secrets/.
# For standalone deployments, *_FILE variables can point to mounted secret files.
# FLASK_SECRET_KEY_FILE=/run/secrets/flask_secret_key
# Single-user web login (ignored when MULTI_USER_AUTH_ENABLED=true).
# Set both values; use a unique password of at least 16 characters.
# WEB_AUTH_USERNAME=
# WEB_AUTH_PASSWORD=
# WEB_AUTH_PASSWORD_FILE=/run/secrets/web_auth_password
# Enable invite-only accounts with per-user output/upload storage instead of the single-user login.
# MULTI_USER_AUTH_ENABLED=true
# AUTH_DATABASE_PATH=/app/scheduled_posts/accounts.sqlite3
# Prometheus scrape password; Compose reads it from the git-ignored secrets file.
# Direct environment configuration is supported outside Compose.
# PROMETHEUS_PASSWORD=
# PROMETHEUS_PASSWORD_FILE=/run/secrets/prometheus_password
# Set WEB_HOST=0.0.0.0 for a Docker container; authentication is required on non-localhost binds.
# WEB_HOST=127.0.0.1
# Set true when serving over HTTPS; required for /ready to pass.
# SESSION_COOKIE_SECURE=true
# Number of trusted reverse-proxy hops that set X-Forwarded-* headers (default: 0).
# The bundled TLS Compose overlay sets this to 1 and removes the app's published HTTP port.
# TRUSTED_PROXY_HOPS=0
# Exact IP of the trusted proxy peer; required when TRUSTED_PROXY_HOPS is non-zero.
# TRUSTED_PROXY_IP=
# Optional TLS overlay listener settings (default: loopback ports 8443/8080).
# TLS_BIND_ADDRESS=127.0.0.1
# TLS_HTTPS_PORT=8443
# TLS_HTTP_PORT=8080
# Certbot HTTP-01 webroot mount for the TLS overlay.
# CERTBOT_WEBROOT=./certbot/www
# Optional shared Flask-Limiter storage URI for multi-worker deployments (default: memory://).
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# Optional central SQLite scheduler database for jobs saved to multiple output folders.
# SCHEDULER_DB_PATH=
# Optional persistent metrics/error-event database (default: scheduled_posts/observability.sqlite3).
# OBSERVABILITY_DB_PATH=scheduled_posts/observability.sqlite3
# Web schedules are confined to this output root (default: scheduled_posts).
# SCHEDULED_OUTPUT_ROOT=scheduled_posts
# Optional external exception reporting; configure only with an approved Sentry project.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# Optional rotating application log file; stdout/stderr logging remains enabled.
# APP_LOG_FILE=logs/application.log
# APP_LOG_MAX_BYTES=10485760
# APP_LOG_BACKUP_COUNT=3
