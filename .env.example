# Copy this file to .env and fill in your own values.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=gpt2
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-a-03-2025
# Optional stable Flask session/CSRF signing key; generate with secrets.token_hex(32).
# FLASK_SECRET_KEY=
# Set true when serving over HTTPS; required for /ready to pass.
# SESSION_COOKIE_SECURE=true
# Optional shared Flask-Limiter storage URI for multi-worker deployments (default: memory://).
# RATELIMIT_STORAGE_URI=redis://localhost:6379
# Optional persistent metrics/error-event database (default: scheduled_posts/observability.sqlite3).
# OBSERVABILITY_DB_PATH=scheduled_posts/observability.sqlite3
# Optional external exception reporting; configure only with an approved Sentry project.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
